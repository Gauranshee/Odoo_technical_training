<odoo>

    <!-- ================================================================
         Estate Property — Form View
         ================================================================
         Correct Odoo form layout:
           <header> : statusbar widget + action buttons (outside <sheet>)
           <sheet>  : all visible form content
             <div class="oe_title"> : record name / title
             <group>  : field columns
             <notebook> : tabbed pages for detailed sections
    -->
    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>

                <!-- header: contains the status pipeline bar and action buttons.
                     Must be OUTSIDE <sheet> so Odoo renders it in the top bar area. -->
                <header>
                    <button name="action_sold"
                            string="Mark as Sold"
                            type="object"
                            invisible="state in ['sold', 'canceled']"/>
                    <button name="action_cancelled"
                            string="Cancel"
                            type="object"
                            invisible="state in ['sold', 'canceled']"/>
                    <button name="action_cancelled"
                            string="Cancel and Archive"
                            type="object"
                            context="{'archive_on_cancel': True}"
                            invisible="state in ['sold', 'canceled']"/>

                    <!-- statusbar: renders the horizontal pipeline progress indicator.
                         statusbar_visible controls which stages are always shown. -->
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>

                <sheet>
                    <!-- Title area: property name and auto-generated sequence code. -->
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Property Title"/></h1>
                        <h2>
                            <!-- readonly="1": prevents users from editing the system-generated code. -->
                            <field name="seq_estate_property" readonly="1"/>
                        </h2>
                    </div>

                    <!-- Two-column layout for core property fields. -->
                    <group>
                        <group string="Location &amp; Availability">
                            <field name="postcode"/>
                            <field name="date_availability"/>
                            <!-- invisible="not garden": only visible when Garden checkbox is ticked. -->
                            <field name="garden_area"        invisible="not garden"/>
                            <field name="garden_orientation" invisible="not garden"/>
                        </group>
                        <group string="Pricing">
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>

                    <!-- Notebook: tabbed pages for secondary details. -->
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Property description..."/>
                            <group>
                                <group string="Property Details">
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="property_type_id"
                                           options="{'no_create': True, 'no_edit': True}"/>
                                    <!-- many2many_tags: renders tags as coloured chips. -->
                                    <field name="tag_ids"
                                           widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </group>
                                <group string="Amenities &amp; Area">
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="total_area"/>
                                    <field name="best_price"/>
                                </group>
                            </group>
                        </page>

                        <page string="Offer">
                            <!-- readonly condition: prevent new offers after acceptance or sale. -->
                            <field name="offer_ids"
                                   readonly="state in ['offer_accepted', 'sold', 'canceled']">
                                <tree editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="state"/>
                                    <button icon="fa-check" type="object"
                                            name="action_accept" title="Accept Offer"
                                            invisible="state == 'accepted'"/>
                                    <button icon="fa-times" type="object"
                                            name="action_refuse" title="Refuse Offer"
                                            invisible="state == 'refused'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter: message log and activity panel (from mail.thread mixin). -->
                <chatter/>
            </form>
        </field>
    </record>


    <!-- ================================================================
         Estate Property — Tree (List) View
    ================================================================ -->
    <record id="estate_property_tree_view" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <!-- decoration-*: applies CSS styling to rows based on field values.
                 The 'state' field is invisible="1" so it drives decorations without displaying. -->
            <tree decoration-success="state == 'offer_received'"
                  decoration-bf="state == 'offer_accepted'"
                  decoration-muted="state == 'sold'">
                <field name="seq_estate_property" string="Code"/>
                <field name="name"             string="Title"/>
                <field name="state"            invisible="1"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"      string="Living Area"/>
                <field name="expected_price"   string="Expected Price" optional="show"/>
                <field name="selling_price"    string="Selling Price"/>
                <field name="date_availability" string="Available From"/>
            </tree>
        </field>
    </record>


    <!-- Window action: opens estate.property records in tree then form view. -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- ================================================================
         Estate Property — Search View
    ================================================================ -->
    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <!-- filter_domain: custom domain used when this field is searched. -->
                <field name="living_area"
                       filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>
                <filter name="filter_new"
                        string="New Properties"
                        domain="[('state', '=', 'new')]"/>
                <filter name="filter_offer_received"
                        string="Offer Received"
                        domain="[('state', '=', 'offer_received')]"/>
                <filter name="available"
                        string="Available"
                        domain="[('state', '=', 'new')]"/>
                <!-- Group By filters -->
                <filter name="group_by_postcode"
                        string="Postcode"
                        context="{'group_by': 'postcode'}"/>
            </search>
        </field>
    </record>


    <!-- ================================================================
         Property Type — Action, Tree, Form, Search Views
    ================================================================ -->
    <record id="action_property_type" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="estate_property_type_tree" model="ir.ui.view">
        <field name="name">estate.property.type.tree</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <tree>
                <!-- handle widget: enables drag-and-drop row reordering by sequence. -->
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Window action for property offers — must be defined BEFORE it is referenced
         in the stat button below (XML is processed top to bottom). -->
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="estate_property_type_form" model="ir.ui.view">
        <field name="name">estate.property.type.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- oe_button_box: renders stat buttons (smart buttons) in the top-right corner. -->
                    <div class="oe_button_box" name="button_box">
                        <!-- Stat button: shows offer count, navigates to the offers list on click. -->
                        <button name="%(estate_property_offer_action)s"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-money">
                            <field name="offer_count" widget="statinfo" string="Offers"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                    </group>
                    <!-- Inline One2many list: shows properties linked to this type. -->
                    <field name="property_ids">
                        <tree>
                            <field name="name"/>
                            <field name="expected_price"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_type_search" model="ir.ui.view">
        <field name="name">estate.property.type.search</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <!-- ================================================================
         Property Offer — Tree and Form Views
    ================================================================ -->
    <record id="estate_property_offer_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.tree</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <tree editable="bottom"
                  decoration-danger="state == 'refused'"
                  decoration-success="state == 'accepted'">
                <field name="property_id"/>
                <field name="property_type_id"/>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="state" invisible="1"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button icon="fa-check" type="object" name="action_accept"
                        title="Accept Offer"
                        invisible="state == 'accepted'"/>
                <button icon="fa-times"  type="object" name="action_refuse"
                        title="Refuse Offer"
                        invisible="state == 'refused'"/>
            </tree>
        </field>
    </record>

    <record id="estate_property_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <!-- header: action buttons placed outside <sheet> in the top bar. -->
                <header>
                    <field name="state" invisible="1"/>
                    <button name="action_accept" string="Accept" type="object"
                            invisible="state in ['accepted', 'refused']"/>
                    <button name="action_refuse" string="Refuse"  type="object"
                            invisible="state in ['accepted', 'refused']"/>
                </header>
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="state"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ================================================================
         Property Tag — Action and Tree View
    ================================================================ -->
    <record id="estate_property_tag_action" model="ir.actions.act_window">
        <field name="name">Property Tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="estate_property_tag_tree" model="ir.ui.view">
        <field name="name">estate.property.tag.tree</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>


    <!-- ================================================================
         res.users Form View Inheritance — XML Inheritance
         Adds a "Properties" tab to the existing user profile form.
         Uses XPath to inject content into the existing <notebook> element.
    ================================================================ -->
    <record id="view_users_form_inherit_estate" model="ir.ui.view">
        <field name="name">res.users.form.inherit.estate</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- XPath: target the notebook element and insert a new page inside it. -->
            <xpath expr="//notebook" position="inside">
                <page string="Properties">
                    <field name="property_ids">
                        <tree>
                            <field name="name"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


    <!-- ================================================================
         Record Rule — Security
         Restricts estate.property visibility to the record owner only,
         applied to the Estate Read Only group.
    ================================================================ -->
    <record id="estate_rule_readonly_user" model="ir.rule">
        <field name="name">Estate: users see only their own properties</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[(4, ref('estate.group_estate_readonly'))]"/>
        <!-- domain_force: evaluated per request; 'user' refers to the logged-in user. -->
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

</odoo>
